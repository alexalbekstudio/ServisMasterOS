# ============================================
# APP
# ============================================
APP_NAME=ServisMasterOS
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1

# ============================================
# DATABASE (Docker PostgreSQL na portu 5433)
# ============================================
POSTGRES_SERVER=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=servismaster_db

# ============================================
# JWT
# ============================================
SECRET_KEY=promeni_ovaj_kljuc_u_produkciji_generisi_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# ============================================
# CORS
# ============================================
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000

# ============================================
# PUBLIC URL (za notifikacije)
# ============================================
PUBLIC_BASE_URL=http://localhost:8000

# ============================================
# TELEGRAM (opciono)
# ============================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEV_CHAT_ID=

# ============================================
# EMAIL (SMTP)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TEST_EMAIL_RECIPIENT=

# ============================================
# VIN Dekoder (opciono - NHTSA je besplatan)
# ============================================
NHTSA_API_URL=https://vpic.nhtsa.dot.gov/api/vehicles/DecodeVin

# ============================================
# Fiskalizacija (PFR) - za produkciju
# ============================================
PFR_SANDBOX_URL=https://vsdc.sandbox.suf.purs.gov.rs
PFR_PRODUCTION_URL=https://vsdc.suf.purs.gov.rs
PFR_CERTIFICATE_PATH=
PFR_PAK_CODE=